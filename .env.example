# ---- Server ----
PORT=4000
# Public base URL the server is reached at (used to build CDN links and the OAuth redirect).
PUBLIC_BASE_URL=http://localhost:4000
# Where the SQLite database and local-backend blobs live (relative to the server/ workspace).
DATA_DIR=./data

# ---- Admin login (single-user PoC) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string
# Require HTTPS for the session cookie. Defaults to on when NODE_ENV=production.
# Set to false to log in over plain HTTP (e.g. a local Docker container); true behind TLS.
# COOKIE_SECURE=false

# ---- OneDrive / Microsoft Graph (optional; required only to connect OneDrive) ----
# Register an app at https://portal.azure.com > App registrations.
#   Redirect URI (Web):   http://localhost:4000/api/oauth/onedrive/callback
#   Delegated permissions: Files.ReadWrite  offline_access  User.Read
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" works for personal + work/school accounts; use a tenant id to restrict.
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:4000/api/oauth/onedrive/callback
MS_SCOPES=Files.ReadWrite offline_access User.Read

# ---- Google Drive (optional; required only to connect Google Drive) ----
# Create an OAuth client at https://console.cloud.google.com > APIs & Services > Credentials.
#   Application type:     Web application
#   Authorized redirect:  http://localhost:4000/api/oauth/google/callback
#   Enable the "Google Drive API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
# drive.file limits access to files this app creates (least privilege); email identifies the account.
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file openid email
