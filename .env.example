# ---- Server ----
PORT=4000
# Public base URL a browser uses to reach the app. Behind a tunnel/proxy set this to your
# HTTPS URL (e.g. https://file.example.com). CDN links and the OAuth callback URLs derive from it.
PUBLIC_BASE_URL=https://file.amcmail.co.uk:4000
# Where the SQLite database and local-backend blobs live (relative to the server/ workspace).
DATA_DIR=./data

# ---- Admin login (single-user PoC) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=this123is456a789long098random765string4321
# Require HTTPS for the session cookie. Defaults to on when NODE_ENV=production.
# Set to false to log in over plain HTTP (e.g. a local Docker container); true behind TLS.
# COOKIE_SECURE=false
# Give every uploaded file an automatic friendly link alias derived from its name.
# AUTO_ALIAS_ON_UPLOAD=false
# Chunk size (MB) the web UI uses for large uploads, so no single request hits a proxy's
# body-size cap (Cloudflare Free/Pro = 100 MB). Files below this size upload in one request.
# UPLOAD_CHUNK_MB=32

# ---- Windows drive (WebDAV endpoint at /dav) ----
# Enabled by default; the drive's Basic-auth credentials default to the admin login above.
# Set a dedicated username/password to give the drive its own credentials.
# DAV_ENABLED=true
# DAV_USERNAME=
# DAV_PASSWORD=

# ---- OneDrive / Microsoft Graph (optional; required only to connect OneDrive) ----
# Register an app at https://portal.azure.com > App registrations.
#   Redirect URI (Web):   http://localhost:4000/api/oauth/onedrive/callback
#   Delegated permissions: Files.ReadWrite  offline_access  User.Read
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" works for personal + work/school accounts; use a tenant id to restrict.
MS_TENANT=common
# Optional: defaults to <PUBLIC_BASE_URL>/api/oauth/onedrive/callback. Must match the Azure
# app's Redirect URI exactly. Leave unset unless you need to override it.
# MS_REDIRECT_URI=
MS_SCOPES=Files.ReadWrite offline_access User.Read

# ---- Google Drive (optional; required only to connect Google Drive) ----
# Create an OAuth client at https://console.cloud.google.com > APIs & Services > Credentials.
#   Application type:     Web application
#   Authorized redirect:  http://localhost:4000/api/oauth/google/callback
#   Enable the "Google Drive API" for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to <PUBLIC_BASE_URL>/api/oauth/google/callback. Must match the Google
# OAuth client's Authorized redirect URI exactly. Leave unset unless you need to override it.
# GOOGLE_REDIRECT_URI=
# drive.file limits access to files this app creates (least privilege); email identifies the account.
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file openid email
